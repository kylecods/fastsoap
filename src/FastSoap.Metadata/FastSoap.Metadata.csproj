<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Static and generated WSDL 1.1 and XSD metadata serving with ETag caching and configured address policy for FastSoap.</Description>
    <PackageTags>soap;wsdl;xsd;metadata;aot;fastsoap</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <RootNamespace>FastSoap.Metadata</RootNamespace>
    <AssemblyName>FastSoap.Metadata</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastSoap.Abstractions\FastSoap.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="XmlEssentials" />
  </ItemGroup>

</Project>
