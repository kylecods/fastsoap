<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>ASP.NET Core endpoint hosting, routing, authorization, telemetry, and metadata middleware for FastSoap SOAP 1.1 and 1.2 services.</Description>
    <PackageTags>soap;aspnetcore;kestrel;wcf;aot;utf8;fastsoap</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <RootNamespace>FastSoap.AspNetCore</RootNamespace>
    <AssemblyName>FastSoap.AspNetCore</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastSoap.Abstractions\FastSoap.Abstractions.csproj" />
    <ProjectReference Include="..\FastSoap.Core\FastSoap.Core.csproj" />
    <ProjectReference Include="..\FastSoap.Metadata\FastSoap.Metadata.csproj" />
  </ItemGroup>

</Project>
