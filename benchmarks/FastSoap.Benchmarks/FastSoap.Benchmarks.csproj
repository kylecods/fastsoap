<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>FastSoap.Benchmarks</RootNamespace>
    <AssemblyName>FastSoap.Benchmarks</AssemblyName>
    <EnableCoreWCFOperationInvokerGenerator>true</EnableCoreWCFOperationInvokerGenerator>
    <EnableCoreWCFParameterInjectionGenerator>true</EnableCoreWCFParameterInjectionGenerator>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="CloudNimble.Text.Xml.XmlSerializer.IsReflectionEnabledByDefault" Value="false" Trim="true" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FastSoap.Abstractions\FastSoap.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\FastSoap.AspNetCore\FastSoap.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\FastSoap.Core\FastSoap.Core.csproj" />
    <ProjectReference Include="..\..\src\FastSoap.Generators\FastSoap.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained;PublishTrimmed" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="CoreWCF.Http" />
    <PackageReference Include="CoreWCF.Primitives" />
    <PackageReference Include="SoapCore" />
    <PackageReference Include="XmlEssentials" />
  </ItemGroup>

</Project>
