<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>FastSoap.IntegrationTests</RootNamespace>
    <AssemblyName>FastSoap.IntegrationTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="CloudNimble.Text.Xml.XmlSerializer.IsReflectionEnabledByDefault" Value="false" Trim="true" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FastSoap.Abstractions\FastSoap.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\FastSoap.AspNetCore\FastSoap.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\FastSoap.Core\FastSoap.Core.csproj" />
    <ProjectReference Include="..\..\src\FastSoap.Metadata\FastSoap.Metadata.csproj" />
    <ProjectReference Include="..\..\src\FastSoap.Generators\FastSoap.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained;PublishTrimmed" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="XmlEssentials" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>
