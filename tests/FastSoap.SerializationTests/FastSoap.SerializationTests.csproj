<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>FastSoap.SerializationTests</RootNamespace>
    <AssemblyName>FastSoap.SerializationTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="CloudNimble.Text.Xml.XmlSerializer.IsReflectionEnabledByDefault" Value="false" Trim="true" />
