<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>UTF-8-native, Native AOT-compatible SOAP 1.1 and SOAP 1.2 protocol engine, buffer management, and XmlEssentials serialization adapter for FastSoap.</Description>
    <PackageTags>soap;soap11;soap12;wcf;aot;utf8;xml;fastsoap</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>FastSoap.Core</RootNamespace>
    <AssemblyName>FastSoap.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FastSoap.AspNetCore</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FastSoap.ProtocolTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FastSoap.SerializationTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastSoap.Abstractions\FastSoap.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="XmlEssentials" />
  </ItemGroup>

</Project>
